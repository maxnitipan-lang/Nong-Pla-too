# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง (ห้าม commit .env)

# ---- Backend (server/_core/env.ts) ----
# OAuth client / app id (ใช้ทั้ง frontend และ backend)
VITE_APP_ID=
# ความลับสำหรับเซ็น session cookie (สุ่มสตริงยาว ๆ)
JWT_SECRET=
# connection string ของ MySQL / TiDB — ถ้าเว้นว่าง ระบบจะใช้ demo data ใน shared/campus.ts
DATABASE_URL=
# รหัสผ่านเข้า /admin บนเว็บจริง (แทน Manus OAuth) — เว้นว่าง = ไม่มีช่องกรอกรหัส
ADMIN_PASSWORD=
# Manus OAuth server base URL
OAUTH_SERVER_URL=
# openId ของผู้ดูแลระบบ จะได้ role = admin อัตโนมัติเมื่อ login ครั้งแรก
OWNER_OPEN_ID=
# (ไม่บังคับ) proxy สำหรับ storage + การแจ้งเตือน
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ---- Frontend (client, ใช้ผ่าน import.meta.env) ----
VITE_OAUTH_PORTAL_URL=

# แชตบอตถาม-ตอบ — Google Gemini (ฟรี ไม่ต้องผูกบัตร) https://aistudio.google.com/apikey
# เว้นว่าง = ปุ่มแชตไม่ขึ้น  ·  ใช้ผู้ให้บริการอื่นได้ด้วย CHAT_BASE_URL + CHAT_MODEL
GEMINI_API_KEY=
# CHAT_MODEL=gemini-3.1-flash-lite
# CHAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# แผนที่หลัก: Google My Maps embed URL (Share > Embed > คัดลอก src ของ <iframe>)
# รูปแบบ: https://www.google.com/maps/d/embed?mid=XXXXXXXX
# ค่านี้เป็นเพียง fallback ตอน build — เมื่อเชื่อมต่อฐานข้อมูลแล้ว ให้ตั้งค่าจริงที่
# หน้า /admin/settings (เก็บในตาราง site_settings) ซึ่งจะ override ค่านี้
# ถ้าทั้งสองที่เว้นว่าง หน้าเว็บจะใช้แผนที่วาด (fallback) พร้อมหมุดอาคาร
VITE_MYMAPS_EMBED_URL=
# (ไม่บังคับ) Google Maps JavaScript API — สำรองไว้ ปัจจุบันแอปใช้ Google My Maps embed
VITE_GOOGLE_MAPS_API_KEY=
# (ไม่บังคับ) OpenRouteService / HeiGIT — เส้นทางเดินจริงใน "ดูเส้นทางในแอป"
# ฟรี สมัครด้วยอีเมล ไม่ต้องผูกบัตร: https://openrouteservice.org/dev/#/signup
# ใช้ Basic Key จากหน้า account.heigit.org (Directions V2 = 2000/วัน)
# เว้นว่าง = แผนที่ OSM + เส้นตรง + ระยะโดยประมาณ
VITE_ORS_API_KEY=
# ค่าที่ Manus WebDev เตรียมให้อัตโนมัติใน preview (ไม่ต้องตั้งเองตอน deploy ปกติ)
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
